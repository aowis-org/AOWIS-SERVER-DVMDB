# AOWIS MODEL source-compatibility fingerprint (identical in GUI and DVMDB).
# Hash the actual checkout contents, including uncommitted edits. A Git HEAD
# revision alone cannot detect dirty, differently built MODEL submodules.
function(aowis_generate_model_codec_fingerprint model_root generated_dir)
    if(NOT IS_DIRECTORY "${model_root}/include" OR NOT IS_DIRECTORY "${model_root}/src")
        message(FATAL_ERROR "MODEL sources are required to calculate the codec fingerprint")
    endif()
    file(GLOB_RECURSE model_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES false
        RELATIVE "${model_root}"
        "${model_root}/include/*" "${model_root}/src/*")
    foreach(extra_source IN ITEMS CMakeLists.txt docs/model_codec_fields.json)
        if(EXISTS "${model_root}/${extra_source}")
            list(APPEND model_inputs "${extra_source}")
        endif()
    endforeach()
    list(SORT model_inputs)
    set(fingerprint_manifest "AOWIS-MODEL-SOURCE-COMPAT-V1\n")
    set(absolute_inputs "")
    foreach(relative_file IN LISTS model_inputs)
        set(absolute_file "${model_root}/${relative_file}")
        file(SHA256 "${absolute_file}" file_digest)
        string(APPEND fingerprint_manifest "${relative_file}\n${file_digest}\n")
        list(APPEND absolute_inputs "${absolute_file}")
    endforeach()
    # Content changes, not just additions/removals, must regenerate the hash.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${absolute_inputs})
    string(SHA256 model_fingerprint "${fingerprint_manifest}")
    file(MAKE_DIRECTORY "${generated_dir}")
    set(output "${generated_dir}/aowis_model_codec_fingerprint.h")
    set(content "#pragma once\n#define AOWIS_MODEL_CODEC_FINGERPRINT \"${model_fingerprint}\"\n")
    if(EXISTS "${output}")
        file(READ "${output}" old_content)
    else()
        set(old_content "")
    endif()
    if(NOT old_content STREQUAL content)
        file(WRITE "${output}" "${content}")
    endif()
    message(STATUS "AOWIS MODEL source fingerprint: ${model_fingerprint}")
endfunction()
